{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "build",
  "redirects": [
    { "source": "/tools", "destination": "/", "permanent": false },
    { "source": "/tools/", "destination": "/", "permanent": false },
    { "source": "/editor", "destination": "/tools/editor", "permanent": true },
    { "source": "/editor/:id", "destination": "/tools/editor/:id", "permanent": true },
    { "source": "/drop", "destination": "/tools/drop", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tools/editor", "destination": "/editor.html" },
    { "source": "/tools/editor/:id", "destination": "/document.html" },
    { "source": "/tools/drop", "destination": "/drop.html" },
    { "source": "/tools/rent-vs-buy-calculator", "destination": "/rent-vs-buy-calculator.html" }
  ],
  "headers": [
    {
      "source": "/tools/editor/:id",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/editor/:id",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
